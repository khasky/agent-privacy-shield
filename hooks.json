{
  "agent-privacy-shield": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./adapters/antigravity/scripts/hook.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "view_file|write_to_file|replace_file_content|multi_replace_file_content|list_dir|find_by_name|grep_search|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./adapters/antigravity/scripts/hook.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./adapters/antigravity/scripts/hook.mjs",
        "timeout": 10
      }
    ]
  }
}