{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/adapters/codex/scripts/hook.mjs",
            "statusMessage": "Initializing Agent Privacy Shield"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/adapters/codex/scripts/hook.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Read|Write|Edit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/adapters/codex/scripts/hook.mjs"
          }
        ]
      }
    ]
  }
}