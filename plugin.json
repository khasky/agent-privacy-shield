  "author": {
    "name": "Khasky",
    "url": "https://github.com/khasky"
  },
  "homepage": "https://github.com/khasky/agent-privacy-shield",
  "repository": "https://github.com/khasky/agent-privacy-shield",
  "license": "MIT",
  "keywords": [
    "privacy",
    "security",
    "redaction",
    "pii",
    "codex"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./adapters/codex/hooks/hooks.json",
      "interface": {
        "displayName": "Agent Privacy Shield",
        "shortDescription": "Privacy virtualization for Codex and coding agents",
        "developerName": "Khasky",
        "category": "Developer Tools",
        "websiteURL": "https://github.com/khasky/agent-privacy-shield",
        "capabilities": [
          "Read",
          "Write"
        ]
      }
    }
